[Unit]
Description=WXDispatch - NWS and IPAWS alerts over Meshtastic / MeshCore
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Populated by install-linux.sh:
#   __USER__    the service account (added to the dialout group for serial)
#   __DIR__     install directory (holds the virtualenv + source)
User=__USER__
Group=dialout
WorkingDirectory=__DIR__
Environment=MESH_WX_HOST=0.0.0.0
Environment=MESH_WX_PORT=8110
Environment=MESH_WX_DB=__DIR__/data/mesh-wx.db
# Optional deployment-locked MeshCore flood scope. When present, this overrides
# the database and makes successful scope selection mandatory before each send.
EnvironmentFile=-/etc/mesh-wx/meshcore.env
# Optional NWWS-OI metadata only. The password itself stays in the private file
# named by MESH_WX_NWWS_PASSWORD_FILE; a missing env file leaves NWWS disabled.
EnvironmentFile=-/etc/mesh-wx/nwws.env
# Optional receive-only NOAA Weather Radio RTL-SDR metadata. Disabled when absent.
EnvironmentFile=-/etc/mesh-wx/noaa-sdr.env
ExecStart=__DIR__/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
